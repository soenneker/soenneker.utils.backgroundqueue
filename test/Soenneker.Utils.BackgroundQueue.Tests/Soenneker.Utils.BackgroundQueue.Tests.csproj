<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net11.0</TargetFramework>
        <Features Condition="'$(TargetFramework)' == 'net11.0'">$(Features);runtime-async=on</Features>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <None Remove="appsettings.json" />
    </ItemGroup>

    <ItemGroup>
        <Content Include="appsettings.json">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Soenneker.Asyncs.Initializers" Version="11.0.134" />
        <PackageReference Include="Soenneker.Extensions.ServiceProvider" Version="4.0.348" />
        <PackageReference Include="Soenneker.Utils.Delay" Version="11.0.107" />
        <PackageReference Include="Soenneker.Utils.Test" Version="11.0.344" />
        <PackageReference Include="Soenneker.Tests.Unit" Version="11.0.1411" />
        <PackageReference Include="TUnit" Version="1.76.28" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Soenneker.Utils.BackgroundQueue\Soenneker.Utils.BackgroundQueue.csproj" />
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="AwesomeAssertions" Version="9.6.0" />
        <PackageReference Include="Soenneker.Atomics.ValueBools" Version="11.0.55" />
    </ItemGroup>
</Project>

